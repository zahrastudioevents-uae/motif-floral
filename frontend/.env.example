# After `npm run download:images`, set to true to serve from /public/images
# VITE_USE_LOCAL_IMAGES=true

# Only while the site lives on a preview URL, so the staging copy is not indexed:
# VITE_SITE_URL=https://<preview>.vercel.app
# VITE_NOINDEX=true

# The forms post to /api/... on this same origin. Nothing to set here for them;
# the keys they need live on the Vercel project, see DEPLOY.md.
